{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "allow-set-menu-labels",
    "allow-get-settings",
    "allow-update-settings",
    "allow-power-limit-notice",
    "allow-setup-status",
    "allow-run-setup",
    "allow-confirm-setup",
    "allow-reset-setup",
    "allow-image-backend-choice",
    "allow-set-image-backend",
    "allow-restore-image-backend",
    "allow-generate-image",
    "allow-cancel-generation",
    "allow-generation-defaults",
    "allow-open-edit-image",
    "allow-remove-background",
    "allow-list-recent-prompts",
    "allow-list-prompt-images",
    "allow-set-prompt-favorite",
    "allow-list-gallery",
    "allow-machine-status",
    "allow-copy-generation",
    "allow-hf-token-status",
    "allow-set-hf-token",
    "allow-download-model",
    "allow-list-models",
    "allow-import-model",
    "allow-remove-model",
    "allow-models-directory",
    "allow-python-environment-status",
    "allow-note-3d-intent",
    "allow-await-python-environment",
    "allow-reinstall-python-environment",
    "allow-remove-python-environment",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
